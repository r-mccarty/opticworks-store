{
  "name": "@opticworks/medusa-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "dev:pm2": "pm2 start ecosystem.config.js --only medusa-dev",
    "build": "medusa build",
    "start": "medusa start",
    "start:pm2": "PM2_TARGET=production pm2 start ecosystem.config.js --only medusa-prod",
    "stop:pm2": "pm2 stop ecosystem.config.js",
    "logs:pm2": "pm2 logs medusa-dev",
    "migrate": "medusa db:migrate",
    "seed": "medusa seed",
    "lint": "medusa lint || echo \"Medusa lint not configured\"",
    "prestart": "tsx scripts/validate-build.ts",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "health:check": "tsx scripts/health-check.ts",
    "health:wait": "tsx scripts/health-check.ts --wait",
    "setup:keys": "tsx scripts/setup-publishable-key.ts",
    "validate:build": "tsx scripts/validate-build.ts",
    "catalog:import": "tsx scripts/import-products.ts",
    "catalog:verify": "tsx scripts/verify-catalog.ts",
    "test:smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "^2.11.3",
    "@medusajs/admin-shared": "^2.11.3",
    "@medusajs/medusa": "^2.0.0",
    "@medusajs/utils": "^2.0.0",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@medusajs/dashboard": "^2.11.3",
    "@medusajs/draft-order": "^2.11.3",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2"
  }
}
