{
  "name": "@opticworks/backend",
  "version": "1.0.0",
  "description": "OpticWorks commerce backend (Medusa v2 on Neon Postgres, local Redis).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@react-email/components": "1.0.12",
    "@tanstack/react-query": "5.64.2",
    "ioredis": "5.4.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "resend": "6.33.0",
    "stripe": "18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2",
    "vite": "5.4.20",
    "yalc": "1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.18.1"
}
