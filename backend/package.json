{
  "name": "backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:opticworks": "medusa exec ./src/scripts/seed-opticworks-products.ts",
    "import:products": "npx tsx src/scripts/import-products.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.12.0",
    "@medusajs/cli": "2.12.0",
    "@medusajs/dashboard": "^2.12.0",
    "@medusajs/draft-order": "^2.12.0",
    "@medusajs/framework": "2.12.0",
    "@medusajs/medusa": "2.12.0",
    "@react-email/components": "^1.0.1",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.4.2",
    "resend": "^6.5.2",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@medusajs/admin-shared": "2.12.0",
    "@medusajs/test-utils": "2.12.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "pg": "^8.16.3",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.7.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}