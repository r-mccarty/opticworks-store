---
# SECRETS FILE - Copy to secrets.yml and encrypt with: ansible-vault encrypt secrets.yml
# OR: Pull values from Infisical using the provided script

# PostgreSQL
postgres_db_password: "CHANGE_ME_secure_password_here"

# Medusa Admin
medusa_admin_email: "admin@optic.works"
medusa_admin_password: "CHANGE_ME_admin_password"

# Medusa Secrets (generate with: cd services/medusa && pnpm run generate:secrets)
jwt_secret: "CHANGE_ME_jwt_secret_64chars"
cookie_secret: "CHANGE_ME_cookie_secret_64chars"
medusa_secret_key: "sk_CHANGE_ME"  # Optional: for headless API access

# Cloudflare Tunnel
cloudflare_tunnel_id: "db4738a9-20b7-4dd7-bde2-0760e0188071"
cloudflare_tunnel_credentials: |
  {
    "AccountTag": "your-account-id",
    "TunnelSecret": "your-tunnel-secret",
    "TunnelID": "db4738a9-20b7-4dd7-bde2-0760e0188071"
  }
