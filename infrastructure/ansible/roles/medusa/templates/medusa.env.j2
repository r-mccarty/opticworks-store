# Medusa Backend Environment Configuration
# Generated by Ansible - Do not edit manually

# Database
DATABASE_URL=postgresql://{{ postgres_db_user }}:{{ postgres_db_password }}@localhost:5432/{{ postgres_db_name }}

# Redis
REDIS_URL=redis://localhost:{{ redis_port }}

# Server
PORT={{ medusa_port }}
MEDUSA_BACKEND_URL={{ medusa_backend_url }}

# Admin
MEDUSA_ADMIN_EMAIL={{ medusa_admin_email }}
MEDUSA_ADMIN_PASSWORD={{ medusa_admin_password }}

# Secrets (from generate:secrets or Infisical)
JWT_SECRET={{ jwt_secret }}
COOKIE_SECRET={{ cookie_secret }}
{% if medusa_secret_key is defined %}
MEDUSA_SECRET_KEY={{ medusa_secret_key }}
{% endif %}

# CORS
MEDUSA_STORE_CORS=http://localhost:3000,https://optic.works
MEDUSA_ADMIN_CORS=http://localhost:7000,http://localhost:8000,https://api.optic.works

# Node Environment
NODE_ENV=production
