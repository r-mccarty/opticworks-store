# Medusa Backend Environment Configuration
# Generated by Ansible - Do not edit manually

# Database
# Note: Password must be hex-only (no /, +, =) - validated by generate-secrets-from-infisical.sh
DATABASE_URL=postgresql://{{ postgres_db_user }}:{{ postgres_db_password }}@localhost:5432/{{ postgres_db_name }}

# Redis (Infrastructure Modules)
REDIS_URL=redis://localhost:{{ redis_port }}
REDIS_CACHE_URL=redis://localhost:{{ redis_port }}
REDIS_EVENTS_URL=redis://localhost:{{ redis_port }}
REDIS_WORKFLOW_URL=redis://localhost:{{ redis_port }}

# Server
PORT={{ medusa_port }}
MEDUSA_BACKEND_URL={{ medusa_backend_url }}

# Admin
MEDUSA_ADMIN_EMAIL={{ medusa_admin_email }}
MEDUSA_ADMIN_PASSWORD={{ medusa_admin_password }}

# Secrets (from generate:secrets or Infisical)
JWT_SECRET={{ jwt_secret }}
COOKIE_SECRET={{ cookie_secret }}
{% if medusa_secret_key is defined %}
MEDUSA_SECRET_KEY={{ medusa_secret_key }}
{% endif %}

# CORS
STORE_CORS=http://localhost:3000,https://optic.works,https://www.optic.works
ADMIN_CORS=http://localhost:7000,http://localhost:8000,https://api.optic.works
AUTH_CORS=http://localhost:7000,http://localhost:8000,https://api.optic.works

# Payment (Stripe)
{% if stripe_api_key is defined %}
STRIPE_API_KEY={{ stripe_api_key }}
{% endif %}
{% if stripe_webhook_secret is defined %}
STRIPE_WEBHOOK_SECRET={{ stripe_webhook_secret }}
{% endif %}

# Notifications (Resend)
{% if resend_api_key is defined %}
RESEND_API_KEY={{ resend_api_key }}
{% endif %}
{% if resend_from_email is defined %}
RESEND_FROM_EMAIL="{{ resend_from_email }}"
{% else %}
RESEND_FROM_EMAIL="OpticWorks <noreply@notifications.optic.works>"
{% endif %}

# File Storage (Cloudflare R2)
{% if r2_access_key_id is defined %}
R2_ACCESS_KEY_ID={{ r2_access_key_id }}
R2_SECRET_ACCESS_KEY={{ r2_secret_access_key }}
R2_BUCKET_NAME={{ r2_bucket_name }}
R2_ENDPOINT_URL={{ r2_endpoint_url }}
R2_PUBLIC_URL={{ r2_public_url }}
{% endif %}

# Fulfillment (EasyPost)
# EASYPOST_MODE: "production" (default) or "test"
# - test mode: Uses test API key (EZTK*), labels are VOID and not charged
# - production mode: Uses production API key (EZAK*), real labels are purchased
{% if easypost_mode is defined and easypost_mode %}
EASYPOST_MODE={{ easypost_mode }}
{% endif %}
{% if easypost_api_key is defined and easypost_api_key %}
EASYPOST_API_KEY={{ easypost_api_key }}
{% endif %}
{% if easypost_test_api_key is defined and easypost_test_api_key %}
EASYPOST_TEST_API_KEY={{ easypost_test_api_key }}
{% endif %}
{% if ship_from_name is defined and ship_from_name %}
SHIP_FROM_NAME={{ ship_from_name }}
SHIP_FROM_STREET1={{ ship_from_street1 }}
{% if ship_from_street2 is defined and ship_from_street2 %}
SHIP_FROM_STREET2={{ ship_from_street2 }}
{% endif %}
SHIP_FROM_CITY={{ ship_from_city }}
SHIP_FROM_STATE={{ ship_from_state }}
SHIP_FROM_ZIP={{ ship_from_zip }}
{% if ship_from_phone is defined and ship_from_phone %}
SHIP_FROM_PHONE={{ ship_from_phone }}
{% endif %}
{% endif %}

# Webhook Verification (Hookdeck)
{% if hookdeck_webhook_secret is defined and hookdeck_webhook_secret %}
HOOKDECK_WEBHOOK_SECRET={{ hookdeck_webhook_secret }}
{% endif %}

# Node Environment
NODE_ENV=production
