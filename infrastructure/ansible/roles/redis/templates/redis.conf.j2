# Managed by Ansible. Local only; reached by Medusa over loopback.
bind 127.0.0.1 -::1
port 6379
protected-mode yes
tcp-keepalive 60
timeout 0
aclfile /etc/redis/users.acl

supervised systemd
pidfile /run/redis/redis-server.pid
loglevel notice
logfile ""

databases 4
dir /var/lib/redis

# Durability: AOF (fsync every second) for the workflow engine and event
# queue, plus RDB snapshots that the backup job ships offsite.
appendonly yes
appendfilename "appendonly.aof"
appenddirname "appendonlydir"
appendfsync everysec
aof-use-rdb-preamble yes
save 3600 1 300 100 60 10000
dbfilename dump.rdb
rdbcompression yes
rdbchecksum yes
stop-writes-on-bgsave-error yes

# BullMQ (event bus/workflows) requires noeviction; never drop queued jobs.
maxmemory {{ redis_maxmemory }}
maxmemory-policy noeviction

latency-monitor-threshold 100
slowlog-log-slower-than 10000
