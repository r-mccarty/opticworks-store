#!/bin/bash
# OpticWorks Restic Restore Script
# Auto-generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="/opt/opticworks/backup"

# Load restic environment
source "${BACKUP_DIR}/.restic-env"

usage() {
    echo "Usage: $0 [snapshot_id] [--list|--files|--db-only|--full]"
    echo ""
    echo "Options:"
    echo "  --list      List available snapshots"
    echo "  --files     List files in a snapshot"
    echo "  --db-only   Restore only the database"
    echo "  --full      Full restore (DANGEROUS - stops services)"
    echo ""
    echo "Examples:"
    echo "  $0 --list                    # Show all snapshots"
    echo "  $0 latest --files            # Show files in latest snapshot"
    echo "  $0 latest --db-only          # Restore DB from latest"
    echo "  $0 abc123 --full             # Full restore from snapshot abc123"
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

case "${1:-}" in
    --list)
        echo "Available snapshots:"
        restic snapshots
        exit 0
        ;;
esac

SNAPSHOT_ID="${1:-latest}"
ACTION="${2:---list}"

case "${ACTION}" in
    --files)
        echo "Files in snapshot ${SNAPSHOT_ID}:"
        restic ls "${SNAPSHOT_ID}"
        ;;

    --db-only)
        echo "Restoring database from snapshot ${SNAPSHOT_ID}..."

        RESTORE_DIR=$(mktemp -d)
        trap "rm -rf ${RESTORE_DIR}" EXIT

        # Extract only the database dump
        restic restore "${SNAPSHOT_ID}" --target "${RESTORE_DIR}" --include "*/medusa_db.sql"

        DB_FILE=$(find "${RESTORE_DIR}" -name "medusa_db.sql" | head -1)

        if [ -z "${DB_FILE}" ]; then
            echo "ERROR: No database dump found in snapshot"
            exit 1
        fi

        echo "Found database dump: ${DB_FILE}"
        echo ""
        echo "To restore, run:"
        echo "  sudo -u postgres psql -c 'DROP DATABASE IF EXISTS {{ postgres_db_name }};'"
        echo "  sudo -u postgres psql -c 'CREATE DATABASE {{ postgres_db_name }} OWNER {{ postgres_db_user }};'"
        echo "  psql -U {{ postgres_db_user }} {{ postgres_db_name }} < ${DB_FILE}"
        echo ""
        read -p "Proceed with database restore? (yes/no): " CONFIRM

        if [ "${CONFIRM}" = "yes" ]; then
            echo "Stopping Medusa..."
            pm2 stop {{ pm2_app_name }} || true

            echo "Dropping and recreating database..."
            sudo -u postgres psql -c "DROP DATABASE IF EXISTS {{ postgres_db_name }};"
            sudo -u postgres psql -c "CREATE DATABASE {{ postgres_db_name }} OWNER {{ postgres_db_user }};"

            echo "Restoring database..."
            export PGPASSWORD="{{ postgres_db_password }}"
            psql -h localhost -U {{ postgres_db_user }} {{ postgres_db_name }} < "${DB_FILE}"
            unset PGPASSWORD

            echo "Starting Medusa..."
            pm2 start {{ pm2_app_name }}

            echo "Database restore complete!"
        else
            echo "Restore cancelled."
        fi
        ;;

    --full)
        echo "WARNING: Full restore will:"
        echo "  1. Stop Medusa service"
        echo "  2. Replace {{ app_root }}"
        echo "  3. Restore the database"
        echo "  4. Restart Medusa service"
        echo ""
        read -p "Are you sure? Type 'RESTORE' to confirm: " CONFIRM

        if [ "${CONFIRM}" != "RESTORE" ]; then
            echo "Restore cancelled."
            exit 1
        fi

        echo "Stopping Medusa..."
        pm2 stop {{ pm2_app_name }} || true

        echo "Backing up current state..."
        BACKUP_CURRENT="/opt/opticworks/medusa-backend.pre-restore.$(date +%s)"
        mv {{ app_root }} "${BACKUP_CURRENT}"

        echo "Restoring files from snapshot ${SNAPSHOT_ID}..."
        restic restore "${SNAPSHOT_ID}" --target /

        echo "Restoring database..."
        DB_FILE=$(find /tmp -name "medusa_db.sql" -mmin -5 | head -1)
        if [ -n "${DB_FILE}" ]; then
            sudo -u postgres psql -c "DROP DATABASE IF EXISTS {{ postgres_db_name }};"
            sudo -u postgres psql -c "CREATE DATABASE {{ postgres_db_name }} OWNER {{ postgres_db_user }};"
            export PGPASSWORD="{{ postgres_db_password }}"
            psql -h localhost -U {{ postgres_db_user }} {{ postgres_db_name }} < "${DB_FILE}"
            unset PGPASSWORD
        fi

        echo "Reinstalling dependencies..."
        cd {{ app_root }}
        pnpm install --frozen-lockfile

        echo "Starting Medusa..."
        pm2 start {{ pm2_app_name }}

        echo ""
        echo "Full restore complete!"
        echo "Previous state backed up to: ${BACKUP_CURRENT}"
        ;;

    *)
        usage
        exit 1
        ;;
esac
