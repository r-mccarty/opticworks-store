#!/bin/bash
# OpticWorks Restic Backup Script
# Auto-generated by Ansible - DO NOT EDIT MANUALLY

set -euo pipefail

BACKUP_DIR="/opt/opticworks/backup"
TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)

# Load restic environment
source "${BACKUP_DIR}/.restic-env"

echo "=========================================="
echo "OpticWorks Backup - ${TIMESTAMP}"
echo "=========================================="

# Create temporary directory for database dump
DUMP_DIR=$(mktemp -d)
trap "rm -rf ${DUMP_DIR}" EXIT

# 1. Dump PostgreSQL database
echo "[1/4] Dumping PostgreSQL database..."
export PGPASSWORD="{{ postgres_db_password }}"
pg_dump -h localhost -U {{ postgres_db_user }} {{ postgres_db_name }} > "${DUMP_DIR}/medusa_db.sql"
unset PGPASSWORD
echo "      Database dump complete: $(du -h ${DUMP_DIR}/medusa_db.sql | cut -f1)"

# 2. Create backup with restic
echo "[2/4] Creating restic backup..."
restic backup \
    --verbose \
    --tag medusa \
    --tag "$(date +%Y-%m-%d)" \
    --exclude='node_modules' \
    --exclude='.cache' \
    --exclude='*.log' \
    --exclude='.medusa/cache' \
    {{ app_root }} \
    "${DUMP_DIR}/medusa_db.sql"

# 3. Prune old backups (keep last 7 daily, 4 weekly, 6 monthly)
echo "[3/4] Pruning old backups..."
restic forget \
    --verbose \
    --keep-daily 7 \
    --keep-weekly 4 \
    --keep-monthly 6 \
    --prune

# 4. Check repository integrity (weekly)
if [ "$(date +%u)" -eq 7 ]; then
    echo "[4/4] Running weekly integrity check..."
    restic check
else
    echo "[4/4] Skipping integrity check (runs on Sundays)"
fi

echo "=========================================="
echo "Backup completed successfully!"
echo "=========================================="

# Show recent snapshots
echo ""
echo "Recent snapshots:"
restic snapshots --latest 5
