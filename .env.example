# Cloudflare R2 Storage Configuration
R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name_here
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_bucket_id.r2.dev

# Cloudflare Images (Optional - for image transformations)
CLOUDFLARE_IMAGES_TOKEN=your_cloudflare_images_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Supabase Configuration (Alternative to R2)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Payment Processing (Production Ready)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Address Validation
EASYPOST_API_KEY=EZTK_your_easypost_api_key_here

# Email Service (React Email + Resend - Production Ready)
RESEND_API_KEY=re_your_resend_api_key_here
NEXT_PUBLIC_FROM_EMAIL=YourStore <orders@yourdomain.com>
SUPPORT_REQUEST_EMAIL=support@yourdomain.com

# Cloudflare Turnstile (Bot Protection - Required for contact forms)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ZVKN68R4Y7
# MIXPANEL_TOKEN=your_mixpanel_token_here

# Development/Production Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000