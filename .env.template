# Canonical storefront + backend secrets managed via Infisical.
# Populate per environment (development, staging, production) before running the app.

# Cloudflare R2 Storage (product assets)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Cloudflare Images / API access
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_API_BASE_URL=

# Stripe / Checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_DEV=

# Email + Notifications
RESEND_API_KEY=
NEXT_PUBLIC_FROM_EMAIL=

# Logistics + Integrations
EASYPOST_API_KEY=

# Hetzner + Medusa integration (storefront + admin scripts)
MEDUSA_ENABLED=false
MEDUSA_BASE_URL=http://hetzner-node:9000
MEDUSA_API_TOKEN=
