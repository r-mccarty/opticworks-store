# ============================================================================
# OpticWorks Storefront Environment Configuration
# ============================================================================
#
# SCOPE: Next.js storefront + integrations (Stripe, Resend, Cloudflare, etc.)
# MANAGEMENT: Populated via Infisical (run `pnpm run secrets:pull` in devcontainer)
#
# This file contains ALL secrets for the storefront application including:
# - Cloudflare R2/Images for asset management
# - Stripe for checkout/payments
# - Resend for transactional emails
# - Medusa backend integration (when MEDUSA_ENABLED=true)
# - Analytics and third-party integrations
#
# NOTE: Medusa backend has its own .env file at services/medusa/.env
#       (see services/medusa/.env.example for backend-specific secrets)
#
# WORKFLOW:
# 1. Store all secrets in Infisical with proper environment tags
# 2. In Codespaces/devcontainer: secrets auto-sync via post-create hook
# 3. In local dev: run `pnpm run secrets:pull` manually
# 4. In production: CI/CD injects secrets from Infisical
#
# PRIORITY LEVELS:
# [CRITICAL] - Required for Phase 2 storefront integration (10 vars)
# [BACKEND]  - Backend-only, managed via Ansible (8 vars in services/medusa/.env)
# [PHASE-3]  - Production deployment requirements (11 vars)
# [PHASE-4]  - Analytics, monitoring, optional integrations (15 vars)
#
# CURRENT STATUS (2025-11-19):
# ✅ 10/44 variables in Infisical (22% - see pnpm run secrets:validate)
# 📋 See docs/INFISICAL_SECRETS_INVENTORY.md for complete audit
# ============================================================================

# [PHASE-3] Cloudflare R2 Storage (product assets - production deployment)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# [PHASE-3] Cloudflare Images / API access (production deployment)
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_API_BASE_URL=

# [CRITICAL] Stripe / Checkout (test mode for development)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # ✅ In Infisical
STRIPE_SECRET_KEY=                   # ✅ In Infisical
STRIPE_WEBHOOK_SECRET=               # ❌ MISSING - Get from Stripe dashboard
STRIPE_WEBHOOK_SECRET_DEV=           # [PHASE-4] Optional for local webhook testing

# [CRITICAL] Webhooks (Hookdeck buffers Stripe webhooks)
HOOKDECK_WEBHOOK_SECRET=             # ❌ MISSING - Get from Hookdeck dashboard (Settings > Project > Secrets)

# [CRITICAL] Cloudflare Turnstile (CAPTCHA for contact form)
# Get keys from: https://dash.cloudflare.com → Turnstile → Add Widget
# For development/testing, use Cloudflare's dummy keys:
#   Site key (always pass): 1x00000000000000000000AA
#   Secret key (always pass): 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # Public site key (client-side)
TURNSTILE_SECRET_KEY=                # Secret key (server-side validation)

# [PHASE-4] Email + Notifications (transactional emails)
RESEND_API_KEY=
NEXT_PUBLIC_FROM_EMAIL=

# [PHASE-4] Fulfillment / Shipping (EasyPost)
EASYPOST_API_KEY=                    # Production key (starts with EZAK)
EASYPOST_TEST_API_KEY=               # Test key (starts with EZTK) - for dev/testing
EASYPOST_MODE=production             # "production" or "test"

# Ship-from warehouse address (required for shipping rates)
SHIP_FROM_NAME=OpticWorks
SHIP_FROM_STREET1=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_PHONE=                     # Required for FedEx rates

# [CRITICAL] Medusa Backend Integration (Phase 2 storefront)
# Production: https://api.optic.works | Dev: http://localhost:9000 or SSH tunnel
MEDUSA_ENABLED=false                              # [BACKEND] Internal flag
MEDUSA_BASE_URL=http://hetzner-node:9000          # [BACKEND] Internal service URL
MEDUSA_API_TOKEN=                                 # [BACKEND] Admin API token
NEXT_PUBLIC_MEDUSA_ENABLED=false                  # ✅ In Infisical (set to 'true')
NEXT_PUBLIC_MEDUSA_BASE_URL=http://hetzner-node:9000  # ✅ In Infisical (https://api.optic.works)
NEXT_PUBLIC_MEDUSA_API_TOKEN=                     # ❌ MISSING - Create publishable key in admin
HETZNER_MEDUSA_URL=http://hetzner-node:9000       # [BACKEND] Legacy alias

# [CRITICAL] Admin Credentials (for automation scripts)
# Used by catalog import/setup scripts - see services/medusa/.env.example for backend config
MEDUSA_ADMIN_EMAIL=admin@optic.works              # ✅ In Infisical
MEDUSA_ADMIN_PASSWORD=                            # ⚠️  CONFLICT - Test which password works
MEDUSA_SECRET_KEY=                                # ⚠️  UNCLEAR - May be redundant with JWT_SECRET

# [BACKEND] Database & Cache (managed via Ansible, not in storefront .env)
# These are documented here for reference but live in services/medusa/.env
HETZNER_POSTGRES_URL=postgresql://medusa:<password>@hetzner-node:5432/medusa
HETZNER_POSTGRES_HOST=hetzner-node
HETZNER_POSTGRES_PORT=5432
HETZNER_POSTGRES_DB=medusa
HETZNER_POSTGRES_USER=medusa
HETZNER_POSTGRES_PASSWORD=
HETZNER_REDIS_URL=redis://hetzner-node:6379

# [PHASE-4] Analytics / Telemetry (optional monitoring)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_CLOUD_PROJECT=
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# [PHASE-4] Sentry Error Tracking (client-side only - server uses Cloudflare)
# Get DSN from https://sentry.io (Settings > Projects > Client Keys)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=              # For source maps upload (build-time only)
SENTRY_ORG=opticworks           # Sentry organization slug
SENTRY_PROJECT=opticworks-storefront  # Sentry project slug

# [PHASE-4] Context7 + Gemini (MCP developer tools - optional)
CONTEXT7_API_KEY=
CONTEXT7_MCP_URL=
CONTEXT7_API_URL=
GEMINI_API_KEY=

# [CRITICAL] Misc storefront config
NODE_ENV=development                              # ✅ In Infisical
NEXT_PUBLIC_APP_URL=http://localhost:3000         # ✅ In Infisical
