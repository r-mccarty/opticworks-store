# ============================================================================
# OpticWorks Storefront Environment Configuration
# ============================================================================
#
# SCOPE: Next.js storefront + integrations (Stripe, Resend, Cloudflare, etc.)
# MANAGEMENT: Populated via Infisical (run `pnpm run secrets:pull` in devcontainer)
#
# This file contains ALL secrets for the storefront application including:
# - Cloudflare R2/Images for asset management
# - Stripe for checkout/payments
# - Resend for transactional emails
# - Medusa backend integration (when MEDUSA_ENABLED=true)
# - Analytics and third-party integrations
#
# NOTE: Medusa backend has its own .env file at services/medusa/.env
#       (see services/medusa/.env.example for backend-specific secrets)
#
# WORKFLOW:
# 1. Store all secrets in Infisical with proper environment tags
# 2. In Codespaces/devcontainer: secrets auto-sync via post-create hook
# 3. In local dev: run `pnpm run secrets:pull` manually
# 4. In production: CI/CD injects secrets from Infisical
# ============================================================================

# Cloudflare R2 Storage (product assets)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=

# Cloudflare Images / API access
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL=
CLOUDFLARE_GLOBAL_API_KEY=
CLOUDFLARE_API_BASE_URL=

# Stripe / Checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_DEV=

# Email + Notifications
RESEND_API_KEY=
NEXT_PUBLIC_FROM_EMAIL=

# Logistics + Integrations
EASYPOST_API_KEY=

# Hetzner + Medusa integration (storefront + admin scripts)
# Note: Admin authentication uses email/password (see RFD-005)
MEDUSA_ENABLED=false
MEDUSA_BASE_URL=http://hetzner-node:9000
MEDUSA_API_TOKEN=
NEXT_PUBLIC_MEDUSA_ENABLED=false
NEXT_PUBLIC_MEDUSA_BASE_URL=http://hetzner-node:9000
NEXT_PUBLIC_MEDUSA_API_TOKEN=
HETZNER_MEDUSA_URL=http://hetzner-node:9000

# Admin user credentials (for automation scripts)
# Used when running catalog import/setup scripts from storefront
# See services/medusa/.env.example for backend-specific admin config
MEDUSA_ADMIN_EMAIL=admin@optic.works
MEDUSA_ADMIN_PASSWORD=

# Hetzner Postgres / Redis backing Medusa
HETZNER_POSTGRES_URL=postgresql://medusa:<password>@hetzner-node:5432/medusa
HETZNER_POSTGRES_HOST=hetzner-node
HETZNER_POSTGRES_PORT=5432
HETZNER_POSTGRES_DB=medusa
HETZNER_POSTGRES_USER=medusa
HETZNER_POSTGRES_PASSWORD=
HETZNER_REDIS_URL=redis://hetzner-node:6379

# Analytics / Telemetry
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_CLOUD_PROJECT=
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Context7 + Gemini (MCP)
CONTEXT7_API_KEY=
CONTEXT7_MCP_URL=
CONTEXT7_API_URL=
GEMINI_API_KEY=

# Misc storefront config
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
