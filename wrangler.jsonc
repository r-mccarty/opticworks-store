{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opticworks-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // nodejs_compat: Enable Node.js compatibility
  // nodejs_compat_populate_process_env: Make env vars available via process.env (required for Next.js)
  // See: https://opennext.js.org/cloudflare/howtos/env-vars
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],

  // Fix for next-themes __name error
  // See: https://opennext.js.org/cloudflare/howtos/keep_names
  "keep_names": false,

  // Observability - enable Workers logs
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },

  // Worker assets configuration
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // R2 bucket for incremental cache (ISR/SSG)
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "opticworks-cache"
    }
  ],

  // Self-reference for cache revalidation
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "opticworks-store"
    }
  ],

  // Environment variables. Secrets (MEDUSA_PUBLISHABLE_KEY, CLOUDFLARE_BACKEND_ACCESS_ID/_TOKEN)
  // are set on the Worker, never here: see docs/SECRETS.md.
  // STORE_MODE=medusa: store enabled for testing against the dark backend (owner, 2026-10-30).
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache",
    "STORE_MODE": "medusa",
    "MEDUSA_BACKEND_URL": "https://backend.optic.works"
  },

  // Production environment
  "env": {
    "production": {
      "name": "opticworks-store",
      "routes": [
        {
          "pattern": "optic.works",
          "custom_domain": true
        },
        {
          "pattern": "www.optic.works",
          "custom_domain": true
        }
      ],
      // Override existing DNS records (Vercel)
      "override_existing_dns_record": true,
      // Observability
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        }
      },
      // Inherit these in production env
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "opticworks-cache"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "opticworks-store"
        }
      ],
      "vars": {
        "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache",
        "STORE_MODE": "medusa",
        "MEDUSA_BACKEND_URL": "https://backend.optic.works"
      }
    }
  }
}
