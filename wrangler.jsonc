{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opticworks-store",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  // nodejs_compat: Enable Node.js compatibility
  // nodejs_compat_populate_process_env: Make env vars available via process.env (required for Next.js)
  // See: https://opennext.js.org/cloudflare/howtos/env-vars
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],

  // Fix for next-themes __name error
  // See: https://opennext.js.org/cloudflare/howtos/keep_names
  "keep_names": false,

  // Observability - enable Workers logs
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },

  // Worker assets configuration
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // R2 bucket for incremental cache (ISR/SSG)
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "opticworks-cache"
    }
  ],

  // KV namespace for shipping rates cache
  "kv_namespaces": [
    {
      "binding": "SHIPPING_RATES_CACHE",
      "id": "e11813a7581f480ea39633e492a53222"
    }
  ],

  // Self-reference for cache revalidation
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "opticworks-store"
    }
  ],

  // Environment variables (secrets set via wrangler secret or dashboard)
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache",
    // Medusa API configuration (public vars, safe to commit)
    "NEXT_PUBLIC_MEDUSA_ENABLED": "true",
    "NEXT_PUBLIC_MEDUSA_BASE_URL": "https://api.optic.works",
    // SSR base URL: Direct tunnel access (bypasses Cloudflare hairpin issue)
    // See Track 10 in docs/reference/PHASE3_PLAN.md
    "MEDUSA_SSR_BASE_URL": "https://medusa.optic.works",
    "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY": "pk_db1d0b19fe8e824f1290070dcce30dd51028fd323baf310e7d00cbc89ceb6ece",
    // Stripe publishable key (public, safe to commit)
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51RzVRG3wL1uKpRKE58kQpwSIowyhFePceCMGXW9AgwuhVAANqXPyrnAJqzApwDkrkt2Nwk1gqoI1WFCJGXVH9Sss00V7dXMc5S"
    // Turnstile (contact form CAPTCHA)
    // Configure `NEXT_PUBLIC_TURNSTILE_SITE_KEY` as a Worker variable (public) and `TURNSTILE_SECRET_KEY` as a Worker secret.
    // For local preview (`pnpm run cf:preview`), generate `.dev.vars` via `pnpm run secrets:pull`.
  },

  // Production environment
  "env": {
    "production": {
      "name": "opticworks-store",
      "routes": [
        {
          "pattern": "optic.works",
          "custom_domain": true
        },
        {
          "pattern": "www.optic.works",
          "custom_domain": true
        }
      ],
      // Override existing DNS records (Vercel)
      "override_existing_dns_record": true,
      // Observability
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true
        }
      },
      // Inherit these in production env
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "opticworks-cache"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SHIPPING_RATES_CACHE",
          "id": "e11813a7581f480ea39633e492a53222"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "opticworks-store"
        }
      ],
      "vars": {
        "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache",
        // Medusa API configuration (public vars, safe to commit)
        "NEXT_PUBLIC_MEDUSA_ENABLED": "true",
        "NEXT_PUBLIC_MEDUSA_BASE_URL": "https://api.optic.works",
        // SSR base URL: Direct tunnel access (bypasses Cloudflare hairpin issue)
        "MEDUSA_SSR_BASE_URL": "https://medusa.optic.works",
        "NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY": "pk_db1d0b19fe8e824f1290070dcce30dd51028fd323baf310e7d00cbc89ceb6ece",
        // Stripe publishable key (public, safe to commit)
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_51RzVRG3wL1uKpRKE58kQpwSIowyhFePceCMGXW9AgwuhVAANqXPyrnAJqzApwDkrkt2Nwk1gqoI1WFCJGXVH9Sss00V7dXMc5S"
        // Turnstile (contact form CAPTCHA)
        // Configure `NEXT_PUBLIC_TURNSTILE_SITE_KEY` as a Worker variable (public) and `TURNSTILE_SECRET_KEY` as a Worker secret.
        // For local preview (`pnpm run cf:preview`), generate `.dev.vars` via `pnpm run secrets:pull`.
      }
    }
  }
}
